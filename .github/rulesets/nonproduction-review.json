{
  "name": "Geospan non-production review and founder exceptions",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_type": "User",
      "actor_id": 227131098,
      "bypass_mode": "pull_request"
    },
    {
      "actor_type": "User",
      "actor_id": 230599793,
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/development",
        "refs/heads/Development",
        "refs/heads/staging",
        "refs/heads/Staging"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {
          "enabled": false,
          "allowed_actors": []
        },
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    }
  ]
}
